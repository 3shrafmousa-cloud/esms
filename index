    if(!title) return;
    ESMS_API.posts.upsert({ title, status:'draft', author:'Super Admin' });
    esmsToast('تم إنشاء المنشور (مسودة).', 'success');
    routes.posts();
  });

  document.addEventListener('click', e => {
    const btn = e.target.closest('[data-post-delete]');
    if(!btn) return;
    if(!confirm('هل أنت متأكد من حذف هذا المنشور؟')) return;
    ESMS_API.posts.remove(btn.dataset.postDelete);
    esmsToast('تم حذف المنشور.', 'success');
    routes.posts();
  });

  // ============ Events ============
  routes.events = function(){
    const list = ESMS_API.events.list();
    $('#eventsTable').innerHTML = list.length ? list.map(ev => `
      <tr>
        <td style="font-weight:500;">${ev.title||'—'}</td>
        <td style="color:var(--text-faint);">${ev.date||'—'}</td>
        <td style="color:var(--text-faint);">${ev.location||'—'}</td>
        <td><span class="esms-badge esms-badge--${STATUS_KIND[ev.status]||''}"><i></i>${STATUS_LABELS[ev.status]||'مسودة'}</span></td>
      </tr>`).join('') : `<tr><td colspan="4" style="text-align:center;padding:40px;color:var(--text-faint);">لا توجد فعاليات.</td></tr>`;
  };

  // ============ Departments ============
  routes.departments = function(){
    const list = ESMS_API.departments.list().sort((a,b)=>a.order-b.order);
    $('#deptsTable').innerHTML = list.map(d => `
      <tr>
        <td style="font-weight:500;">${d.name}</td>
        <td style="color:var(--text-faint);">${d.description||'—'}</td>
        <td style="color:var(--text-faint);">${d.order}</td>
        <td><span class="esms-badge esms-badge--${d.active?'success':''}"><i></i>${d.active?'نشط':'معطل'}</span></td>
      </tr>`).join('');
  };

  // ============ Media ============
  routes.media = function(){
    const list = ESMS_API.media.list();
    $('#mediaGrid').innerHTML = list.length ? list.map(m => `
      <div class="stat-card" style="padding:12px;">
        ${m.type?.startsWith('image') ? `<img src="${m.url}" style="aspect-ratio:1;object-fit:cover;border-radius:2px;margin-bottom:10px;">` : `<div style="aspect-ratio:1;background:var(--bg-raised);border-radius:2px;display:flex;align-items:center;justify-content:center;color:var(--text-faint);">${m.type||'file'}</div>`}
        <div style="font-size:12.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${m.name}</div>
        <div style="color:var(--text-faint);font-size:11px;margin-top:3px;">${(m.size/1024).toFixed(1)} KB</div>
        <button class="esms-btn esms-btn--text esms-btn--sm" data-media-delete="${m.id}" style="color:var(--danger);margin-top:8px;">حذف</button>
      </div>`).join('') : `<div style="grid-column:1/-1;text-align:center;padding:40px;border:1px dashed var(--line-strong);border-radius:var(--radius-lg);color:var(--text-faint);">لا توجد ملفات. ابدأ برفع ملف.</div>`;
  };

  $('#mediaUpload')?.addEventListener('change', e => {
    Array.from(e.target.files).forEach(f => ESMS_API.media.add(f));
    esmsToast('تم رفع الملفات.', 'success');
    routes.media();
  });
  document.addEventListener('click', e => {
    const btn = e.target.closest('[data-media-delete]');
    if(!btn) return;
    ESMS_API.media.remove(btn.dataset.mediaDelete);
    routes.media();
  });

  // ============ Activity ============
  routes.activity = function(){
    const list = ESMS_API.activity.list();
    $('#activityTable').innerHTML = list.length ? list.map(x => `
      <tr><td>
        <div style="font-size:13.5px;">${humanAction(x.action)}</div>
        <div style="color:var(--text-faint);font-size:11.5px;margin-top:3px;">${fmtDateTime(x.at)}</div>
      </td></tr>`).join('') : `<tr><td style="text-align:center;padding:40px;color:var(--text-faint);">لا يوجد نشاط مسجل.</td></tr>`;
  };

  // ============ Helpers ============
  function deptName(id){
    if(!id) return '—';
    const d = ESMS_API.departments.list().find(x => x.id === id);
    return d ? d.name : id;
  }
  function fmtDate(iso){
    if(!iso) return '—';
    const d = new Date(iso);
    return `${d.getFullYear()}/${String(d.getMonth()+1).padStart(2,'0')}/${String(d.getDate()).padStart(2,'0')}`;
  }
  function fmtDateTime(iso){
    if(!iso) return '—';
    const d = new Date(iso);
    return `${fmtDate(iso)} — ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
  }
  function humanAction(a){
    const map = {
      'application.created':'استلام طلب تقديم جديد',
      'application.status_changed':'تحديث حالة طلب تقديم',
      'application.deleted':'حذف طلب تقديم',
      'post.created':'إنشاء منشور جديد',
      'post.deleted':'حذف منشور',
      'event.created':'إنشاء فعالية جديدة'
    };
    return map[a] || a;
  }

  // ============ Global Search ============
  $('#globalSearch')?.addEventListener('keydown', e => {
    if(e.key !== 'Enter') return;
    const q = e.target.value.trim();
    if(!q) return;
    appsFilter.search = q;
    go('applications');
  });

  window.__initAdminOnce = function(){
    if(adminInited) return;
    adminInited = true;
    go('dashboard');
    renderHomeDynamic();
  };

  // ============ Home dynamic content ============
  function renderHomeDynamic(){
    // Departments
    const deptList = document.getElementById('homeDeptList');
    if(deptList){
      const depts = ESMS_API.departments.list().filter(d => d.active !== false).sort((a,b)=>a.order-b.order);
      const icons = {
        academy:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 5.2c3-1.5 6-1.5 8 0v13.6c-2-1.5-5-1.5-8 0V5.2z"/><path d="M20 5.2c-3-1.5-6-1.5-8 0v13.6c2-1.5 5-1.5 8 0V5.2z"/></svg>',
        hr:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="9" cy="8" r="3.4"/><path d="M2.5 20c0-3.6 2.9-6.2 6.5-6.2s6.5 2.6 6.5 6.2"/></svg>',
        pr:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M3 10.2v3.6h3.2l5 3.8V6.4l-5 3.8H3z"/><path d="M13.6 9.4a3.1 3.1 0 010 5.2"/><path d="M16.3 6.7a6.6 6.6 0 010 10.6"/></svg>',
        media:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 8.2h3l1.6-2h6.8l1.6 2h3v10.8H4V8.2z"/><circle cx="12" cy="13.4" r="3.3"/></svg>',
        org:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="3.8" y="3.8" width="7" height="7" rx="1"/><rect x="13.2" y="3.8" width="7" height="7" rx="1"/><rect x="3.8" y="13.2" width="7" height="7" rx="1"/><rect x="13.2" y="13.2" width="7" height="7" rx="1"/></svg>'
      };
      deptList.innerHTML = depts.map((d, i) => `
        <div class="dept-row reveal ${i===1?'reveal-delay-1':i===2?'reveal-delay-2':i===3?'reveal-delay-3':''}">
          <div class="dept-icon">${icons[d.id] || icons.org}</div>
          <div><h3>${d.name}</h3><p>${d.description || '—'}</p></div>
        </div>`).join('');
      deptList.querySelectorAll('.reveal').forEach(el => io.observe(el));
    }

    // Posts
    const postsList = document.getElementById('homePostsList');
    if(postsList){
      const posts = ESMS_API.posts.list().filter(p => p.status === 'published').slice(0, 4);
      if(posts.length){
        const featured = posts[0];
        const others = posts.slice(1);
        postsList.innerHTML = `
          <div class="post-feature reveal">
            <h3>${featured.title}</h3>
            <p>${featured.excerpt || featured.content || '—'}</p>
            <p class="meta">${fmtDate(featured.createdAt)}</p>
          </div>
          <div class="post-list reveal reveal-delay-1">
            ${others.map(p => `<div class="post-row"><h4>${p.title}</h4><time>${fmtDate(p.createdAt)}</time></div>`).join('')}
          </div>`;
      } else {
        postsList.innerHTML = `
          <div class="post-feature reveal">
            <h3><span class="field-ph">عنوان الخبر الرئيسي</span></h3>
            <p>سيظهر هنا أحدث خبر بمجرد نشره من لوحة التحكم.</p>
            <p class="meta">—</p>
          </div>
          <div class="post-list reveal reveal-delay-1">
            <div class="post-row"><h4><span class="field-ph">عنوان الخبر</span></h4><time>—</time></div>
            <div class="post-row"><h4><span class="field-ph">عنوان الخبر</span></h4><time>—</time></div>
            <div class="post-row"><h4><span class="field-ph">عنوان الخبر</span></h4><time>—</time></div>
          </div>`;
      }
      postsList.querySelectorAll('.reveal').forEach(el => io.observe(el));
    }

    // Stats
    const s = ESMS_API.stats();
    const statApps = document.getElementById('homeStatApps');
    const statDepts = document.getElementById('homeStatDepts');
    if(statApps) statApps.textContent = s.totalApplications || '—';
    if(statDepts) statDepts.textContent = ESMS_API.departments.list().filter(d=>d.active!==false).length;
  }
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold:0.15 });

  // Render home dynamic content on load
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(renderHomeDynamic, 100);
  });
})();
</script>
</body>
</html>
