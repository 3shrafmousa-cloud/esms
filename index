     PART 5 — JAVASCRIPT (All logic inline)
     ═══════════════════════════════════════════════════════════════════════ -->
<script>
/* =========================================================
   A. API LAYER (localStorage — قابل للتبديل بـ Supabase/Firebase)
   ========================================================= */
(function(g){
  'use strict';
  const NS = 'esms.v1';
  const driver = {
    read(k, fb){ try{ const v = localStorage.getItem(NS+'.'+k); return v ? JSON.parse(v) : fb; }catch(e){ return fb; } },
    write(k, v){ localStorage.setItem(NS+'.'+k, JSON.stringify(v)); }
  };
  const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2,8);
  const now = () => new Date().toISOString();

  const DEFAULT_DEPTS = [
    { id:'academy',  name:'الأكاديمية',      description:'بناء المحتوى المعرفي لتجربة المحاكاة.',  active:true, order:1 },
    { id:'hr',       name:'الموارد البشرية',  description:'إدارة دورة حياة العضوية داخل ESMS.',     active:true, order:2 },
    { id:'pr',       name:'العلاقات العامة',  description:'بناء حضور ESMS داخل الجامعة وخارجها.',   active:true, order:3 },
    { id:'media',    name:'الميديا',         description:'الهوية البصرية والمحتوى المرئي.',         active:true, order:4 },
    { id:'org',      name:'التنظيم',         description:'الإشراف على الجانب التشغيلي والإداري.',   active:true, order:5 }
  ];

  const API = {
    uid, now,
    applications:{
      list(){ return driver.read('applications', []); },
      get(id){ return API.applications.list().find(a => a.id === id); },
      create(data){
        const item = { id:uid(), createdAt:now(), updatedAt:now(), status:'new', ...data };
        const all = API.applications.list(); all.unshift(item);
        driver.write('applications', all);
        API.activity.log('application.created', { id:item.id, name:item.fullName });
        return item;
      },
      updateStatus(id, status){
        const all = API.applications.list();
        const i = all.findIndex(a => a.id === id);
        if(i < 0) return null;
        all[i].status = status; all[i].updatedAt = now();
        driver.write('applications', all);
        API.activity.log('application.status_changed', { id, status });
        return all[i];
      },
      remove(id){
        driver.write('applications', API.applications.list().filter(a => a.id !== id));
        API.activity.log('application.deleted', { id });
      },
      exportCSV(){
        const rows = API.applications.list();
        if(!rows.length) return '';
        const headers = ['id','createdAt','status','fullName','email','phone','university','faculty','year','primaryCommittee','alternativeCommittee','socialLink','motivation'];
        const lines = [headers.join(',')];
        for(const r of rows){
          lines.push(headers.map(h => {
            const v = r[h] == null ? '' : String(r[h]);
            return `"${v.replace(/"/g,'""').replace(/\r?\n/g,' ')}"`;
          }).join(','));
        }
        return '\uFEFF' + lines.join('\n');
      }
    },
    posts:{
      list(){ return driver.read('posts', []); },
      get(id){ return API.posts.list().find(p => p.id === id); },
      upsert(data){
        const all = API.posts.list();
        if(data.id){
          const i = all.findIndex(p => p.id === data.id);
          if(i >= 0){ all[i] = { ...all[i], ...data, updatedAt:now() }; driver.write('posts', all); return all[i]; }
        }
        const item = { id:uid(), createdAt:now(), updatedAt:now(), status:'draft', ...data };
        all.unshift(item); driver.write('posts', all);
        API.activity.log('post.created', { id:item.id, title:item.title });
        return item;
      },
      remove(id){ driver.write('posts', API.posts.list().filter(p => p.id !== id)); API.activity.log('post.deleted', { id }); }
    },
    events:{
      list(){ return driver.read('events', []); },
      upsert(data){
        const all = API.events.list();
        if(data.id){
          const i = all.findIndex(e => e.id === data.id);
          if(i >= 0){ all[i] = { ...all[i], ...data, updatedAt:now() }; driver.write('events', all); return all[i]; }
        }
        const item = { id:uid(), createdAt:now(), updatedAt:now(), status:'draft', ...data };
        all.unshift(item); driver.write('events', all);
        API.activity.log('event.created', { id:item.id, title:item.title });
        return item;
      },
      remove(id){ driver.write('events', API.events.list().filter(e => e.id !== id)); }
    },
    departments:{
      list(){ return driver.read('departments', DEFAULT_DEPTS); },
      save(list){ driver.write('departments', list); },
      upsert(item){
        const list = API.departments.list();
        if(item.id){
          const i = list.findIndex(d => d.id === item.id);
          if(i >= 0){ list[i] = { ...list[i], ...item }; API.departments.save(list); return list[i]; }
        }
        const created = { id:uid(), order:list.length+1, active:true, ...item };
        list.push(created); API.departments.save(list);
        return created;
      },
      remove(id){ API.departments.save(API.departments.list().filter(d => d.id !== id)); }
    },
    media:{
      list(){ return driver.read('media', []); },
      add(file){
        const item = { id:uid(), name:file.name, type:file.type, size:file.size, uploadedAt:now(), url:URL.createObjectURL(file) };
        const all = API.media.list(); all.unshift(item);
        driver.write('media', all);
        return item;
      },
      remove(id){ driver.write('media', API.media.list().filter(m => m.id !== id)); }
    },
    activity:{
      list(){ return driver.read('activity', []); },
      log(action, meta = {}){
        const all = API.activity.list();
        all.unshift({ id:uid(), action, meta, at:now() });
        driver.write('activity', all.slice(0, 200));
      }
    },
    stats(){
      const apps = API.applications.list();
      const posts = API.posts.list();
      const events = API.events.list();
      const media = API.media.list();
      return {
        totalApplications: apps.length,
        newApplications: apps.filter(a => a.status === 'new').length,
        publishedPosts: posts.filter(p => p.status === 'published').length,
        scheduledPosts: posts.filter(p => p.status === 'scheduled').length,
        draftPosts: posts.filter(p => p.status === 'draft').length,
        activeEvents: events.filter(e => e.status === 'published').length,
        mediaCount: media.length
      };
    }
  };
  g.ESMS_API = API;
})(window);

/* =========================================================
   B. THEME TOGGLE + SHARED UI
   ========================================================= */
(function(){
  'use strict';
  const $ = (s, r=document) => r.querySelector(s);
  const $$ = (s, r=document) => Array.from(r.querySelectorAll(s));

  // Theme
  const toggle = $('#themeToggle');
  if(toggle){
    toggle.addEventListener('click', () => {
      const cur = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      const next = cur === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try{ localStorage.setItem('esms-theme', next); }catch(e){}
    });
  }

  // Year
  const y = $('#year'); if(y) y.textContent = new Date().getFullYear();

  // Reveal
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold:0.15 });
  document.addEventListener('DOMContentLoaded', () => {
    $$('.reveal, .flow-step').forEach(el => io.observe(el));
  });

  // Announcement
  const ac = $('#announceClose');
  if(ac) ac.addEventListener('click', () => $('#announce').classList.add('hidden'));

  // Nav scroll
  const nav = $('#nav');
  if(nav){
    window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 20), { passive:true });
  }

  // Mobile menu
  const mm = $('#mobileMenu');
  if(mm){
    $('#hamburger')?.addEventListener('click', () => mm.classList.add('open'));
    $('#mobileClose')?.addEventListener('click', () => mm.classList.remove('open'));
    mm.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mm.classList.remove('open')));
  }

  // Toast
  window.esmsToast = function(msg, kind='success'){
    const el = document.createElement('div');
    el.className = `toast toast--${kind}`;
    el.textContent = msg;
    $('#toasts').appendChild(el);
    requestAnimationFrame(() => el.classList.add('in'));
    setTimeout(() => { el.classList.remove('in'); setTimeout(() => el.remove(), 300); }, 3600);
  };
})();

/* =========================================================
   C. ROUTER — SPA routing between Home / Apply / Admin
   ========================================================= */
(function(){
  'use strict';
  const $ = (s) => document.querySelector(s);
  const $$ = (s) => Array.from(document.querySelectorAll(s));
  const pages = { home: $('#page-home'), apply: $('#page-apply'), admin: $('#page-admin') };
  const overlay = $('#pageTransition');
  let current = 'home';

  function showPage(name, push = true){
    if(!pages[name]) name = 'home';
    if(name === current && push === false) return;

    // Fade out
    overlay.classList.add('in');
    setTimeout(() => {
      Object.entries(pages).forEach(([k, el]) => {
        el.classList.toggle('is-active', k === name);
        el.hidden = (k !== name);
      });
      current = name;
      window.scrollTo({ top:0, behavior:'auto' });
      // Update hash
      if(push){
        const hash = name === 'home' ? '#/' : ('#/' + name);
        if(location.hash !== hash) history.pushState(null, '', hash);
      }
      // Init apply/admin when activated
      if(name === 'apply' && window.__initApplyOnce) window.__initApplyOnce();
      if(name === 'admin' && window.__initAdminOnce) window.__initAdminOnce();
      // Fade in
      requestAnimationFrame(() => overlay.classList.remove('in'));
    }, 260);
  }

  // Intercept clicks on [data-nav] and nav-item[data-route]
  document.addEventListener('click', e => {
    const link = e.target.closest('[data-nav]');
    if(link){
      const nav = link.getAttribute('data-nav');
      if(nav === 'home' || nav === 'apply' || nav === 'admin'){
        e.preventDefault();
        showPage(nav);
        return;
      }
    }
  });

  // Hash changes
  window.addEventListener('hashchange', () => {
    const h = location.hash.replace('#/','').replace('#','');
    const target = (h === '' || h === 'home') ? 'home' : h;
    if(target !== current) showPage(target, false);
  });

  // Boot
  window.__esmsShowPage = showPage;
  document.addEventListener('DOMContentLoaded', () => {
    const h = location.hash.replace('#/','').replace('#','');
    const target = (h === '' || h === 'home') ? 'home' : h;
    // Initial page is already active in markup, just sync
    if(target !== 'home') showPage(target, false);
  });
})();

/* =========================================================
   D. APPLY FORM LOGIC
   ========================================================= */
(function(){
  'use strict';
  const form = document.getElementById('applyForm');
  if(!form) return;
  const shell = document.getElementById('formShell');
  const successState = document.getElementById('successState');
  const progressRail = document.getElementById('progressRail');
  const steps = Array.from(form.querySelectorAll('.form-step'));
  const totalSteps = steps.length;
  let current = 1;
  let departments = [];
  let initialized = false;

  function initDepartments(){
    if(initialized) return;
    initialized = true;
    departments = ESMS_API.departments.list().filter(d => d.active !== false);
    const primary = document.getElementById('f-primaryCommittee');
    const alt = document.getElementById('f-alternativeCommittee');
    primary.innerHTML = '<option value="" disabled selected>اختر اللجنة</option>';
    alt.innerHTML = '<option value="" disabled selected>اختر اللجنة البديلة</option>';
    departments.forEach(d => {
      primary.insertAdjacentHTML('beforeend', `<option value="${d.id}">${d.name}</option>`);
      alt.insertAdjacentHTML('beforeend', `<option value="${d.id}">${d.name}</option>`);
    });
  }

  function setStep(n){
    if(n < 1 || n > totalSteps) return;
    current = n;
    steps.forEach(s => s.classList.toggle('is-active', Number(s.dataset.step) === n));
    progressRail.querySelectorAll('.p-step').forEach(p => {
      const step = Number(p.dataset.step);
      p.classList.toggle('is-active', step === n);
      p.classList.toggle('is-done', step < n);
    });
    form.querySelector('[data-nav-btn="prev"]').hidden = (n === 1);
    const isLast = (n === totalSteps);
    form.querySelector('[data-nav-btn="next"]').hidden = isLast;
    form.querySelector('[data-nav-btn="submit"]').hidden = !isLast;
    if(isLast) renderReview();
  }

  form.querySelector('[data-nav-btn="next"]').addEventListener('click', () => {
    if(validateStep(current)) setStep(current + 1);
  });
  form.querySelector('[data-nav-btn="prev"]').addEventListener('click', () => setStep(current - 1));

  const validators = {
    fullName: v => v.trim().split(/\s+/).length >= 4 ? '' : 'يرجى كتابة الاسم بالكامل (رباعي).',
    email: v => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) ? '' : 'البريد الإلكتروني غير صحيح.',
    phone: v => /^01[0-9]{9}$/.test(v.replace(/\s+/g,'')) ? '' : 'رقم الهاتف يجب أن يكون 11 رقمًا يبدأ بـ 01.',
    university: v => v.trim().length >= 2 ? '' : 'يرجى إدخال اسم الجامعة.',
    faculty: v => v.trim().length >= 2 ? '' : 'يرجى إدخال اسم الكلية.',
    year: v => v ? '' : 'يرجى اختيار الفرقة الدراسية.',
    primaryCommittee: v => v ? '' : 'يرجى اختيار اللجنة الأساسية.',
    alternativeCommittee: (v, d) => {
      if(!v) return 'يرجى اختيار الرغبة البديلة.';
      if(v === d.primaryCommittee) return 'الرغبة البديلة يجب أن تختلف عن الأساسية.';
      return '';
    },
    socialLink: v => (!v || /^https?:\/\//i.test(v)) ? '' : 'الرابط يجب أن يبدأ بـ http:// أو https://',
    motivation: v => v.trim().length >= 100 ? '' : 'الدافع يجب أن يكون 100 حرف على الأقل — اكتب بحرية.'
  };

  function getFieldEls(step){ return Array.from(steps[step-1].querySelectorAll('.esms-field')); }
  function readField(el){ const i = el.querySelector('.esms-input,.esms-select,.esms-textarea'); return i ? i.value : ''; }

  function validateField(el, data){
    const name = el.dataset.field;
    const val = readField(el).trim();
    const isReq = el.querySelector('.req');
    const errEl = el.querySelector('[data-error]');
    if(isReq && !val){ errEl.textContent = 'هذا الحقل مطلوب.'; el.classList.add('has-error'); return false; }
    if(!val){ errEl.textContent = ''; el.classList.remove('has-error'); return true; }
    const fn = validators[name];
    const err = fn ? fn(val, data) : '';
    errEl.textContent = err;
    el.classList.toggle('has-error', !!err);
    el.classList.toggle('is-valid', !err);
    return !err;
  }

  function collectAll(){
    const d = {};
    form.querySelectorAll('.esms-field').forEach(f => { d[f.dataset.field] = readField(f).trim(); });
    return d;
  }

  function validateStep(n){
    const d = collectAll();
    let ok = true;
    getFieldEls(n).forEach(f => { if(!validateField(f, d)) ok = false; });
    return ok;
  }

  form.addEventListener('blur', e => {
    const f = e.target.closest('.esms-field');
    if(f) validateField(f, collectAll());
  }, true);
  form.addEventListener('input', e => {
    const f = e.target.closest('.esms-field');
    if(!f) return;
    if(f.classList.contains('has-error')) validateField(f, collectAll());
    if(f.dataset.field === 'motivation'){
      const c = f.querySelector('[data-count]');
      if(c) c.textContent = e.target.value.trim().length;
    }
  });

  const LABELS = { fullName:'الاسم بالكامل', email:'البريد الإلكتروني', phone:'رقم الهاتف',
    university:'الجامعة', faculty:'الكلية', year:'الفرقة الدراسية',
    primaryCommittee:'اللجنة الأساسية', alternativeCommittee:'الرغبة البديلة',
    socialLink:'رابط التواصل', motivation:'الدافع' };
  function deptName(id){ return (departments.find(d => d.id === id)?.name) || id || '—'; }

  function renderReview(){
    const d = collectAll();
    const block = (title, rows) => `
      <div class="review-block"><h4>${title}</h4>
        ${rows.map(([k,v]) => `<div class="review-row"><span class="k">${k}</span><span class="v">${v || '—'}</span></div>`).join('')}
      </div>`;
    document.getElementById('reviewContent').innerHTML =
      block('البيانات الشخصية', [[LABELS.fullName, d.fullName],[LABELS.email, d.email],[LABELS.phone, d.phone]]) +
      block('البيانات الأكاديمية', [[LABELS.university, d.university],[LABELS.faculty, d.faculty],[LABELS.year, d.year]]) +
      block('التفضيلات والدافع', [[LABELS.primaryCommittee, deptName(d.primaryCommittee)],
        [LABELS.alternativeCommittee, deptName(d.alternativeCommittee)],
        [LABELS.socialLink, d.socialLink || '—'],[LABELS.motivation, d.motivation]]);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if(!validateStep(4)) return;
    const btn = form.querySelector('[data-nav-btn="submit"]');
    btn.classList.add('is-loading');
    const payload = collectAll();
    try{
      await new Promise(r => setTimeout(r, 900));
      ESMS_API.applications.create(payload);
      shell.hidden = true;
      progressRail.hidden = true;
      successState.classList.add('is-active');
      window.scrollTo({ top:0, behavior:'smooth' });
      esmsToast('تم استلام طلبك بنجاح.', 'success');
    }catch(err){
      esmsToast('تعذّر إرسال الطلب. حاول مرة أخرى.', 'danger');
      btn.classList.remove('is-loading');
    }
  });

  window.__initApplyOnce = function(){
    initDepartments();
    setStep(1);
  };
})();

