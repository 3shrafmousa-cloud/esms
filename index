    <div class="form-shell" id="formShell">
      <form id="applyForm" novalidate>

        <fieldset class="form-step is-active" data-step="1">
          <div class="form-step__head">
            <div class="form-step__num">01 — البيانات الشخصية</div>
            <h2 class="form-step__title">من أنت؟</h2>
            <p class="form-step__desc">نحتاج معلومات دقيقة للتواصل معك.</p>
          </div>
          <div class="form-grid">
            <div class="esms-field full" data-field="fullName">
              <label class="esms-field__label" for="f-fullName">الاسم بالكامل (رباعي) <span class="req">*</span></label>
              <input class="esms-input" id="f-fullName" name="fullName" type="text" required placeholder="مثال: محمد أحمد علي حسن" autocomplete="name">
              <span class="esms-field__error" data-error></span>
            </div>
            <div class="esms-field" data-field="email">
              <label class="esms-field__label" for="f-email">البريد الإلكتروني <span class="req">*</span></label>
              <input class="esms-input" id="f-email" name="email" type="email" required placeholder="name@example.com" autocomplete="email" dir="ltr">
              <span class="esms-field__error" data-error></span>
            </div>
            <div class="esms-field" data-field="phone">
              <label class="esms-field__label" for="f-phone">رقم الهاتف (واتساب) <span class="req">*</span></label>
              <input class="esms-input" id="f-phone" name="phone" type="tel" required placeholder="01xxxxxxxxx" inputmode="numeric" dir="ltr">
              <span class="esms-field__hint">رقم مصري من 11 رقمًا يبدأ بـ 01.</span>
              <span class="esms-field__error" data-error></span>
            </div>
          </div>
        </fieldset>

        <fieldset class="form-step" data-step="2">
          <div class="form-step__head">
            <div class="form-step__num">02 — البيانات الأكاديمية</div>
            <h2 class="form-step__title">وضعك الدراسي</h2>
          </div>
          <div class="form-grid">
            <div class="esms-field" data-field="university">
              <label class="esms-field__label" for="f-university">الجامعة <span class="req">*</span></label>
              <input class="esms-input" id="f-university" name="university" type="text" required placeholder="مثال: جامعة اللوتس">
              <span class="esms-field__error" data-error></span>
            </div>
            <div class="esms-field" data-field="faculty">
              <label class="esms-field__label" for="f-faculty">الكلية <span class="req">*</span></label>
              <input class="esms-input" id="f-faculty" name="faculty" type="text" required placeholder="مثال: كلية الإدارة والاقتصاد">
              <span class="esms-field__error" data-error></span>
            </div>
            <div class="esms-field full" data-field="year">
              <label class="esms-field__label" for="f-year">الفرقة الدراسية <span class="req">*</span></label>
              <select class="esms-select" id="f-year" name="year" required>
                <option value="" disabled selected>اختر الفرقة الدراسية</option>
                <option>الفرقة الأولى</option>
                <option>الفرقة الثانية</option>
                <option>الفرقة الثالثة</option>
                <option>الفرقة الرابعة</option>
                <option>خريج</option>
              </select>
              <span class="esms-field__error" data-error></span>
            </div>
          </div>
        </fieldset>

        <fieldset class="form-step" data-step="3">
          <div class="form-step__head">
            <div class="form-step__num">03 — التفضيلات والدافع</div>
            <h2 class="form-step__title">أين تريد أن تبدأ؟</h2>
          </div>
          <div class="form-grid">
            <div class="esms-field" data-field="primaryCommittee">
              <label class="esms-field__label" for="f-primaryCommittee">اللجنة الأساسية (الرغبة الأولى) <span class="req">*</span></label>
              <select class="esms-select" id="f-primaryCommittee" name="primaryCommittee" required>
                <option value="" disabled selected>اختر اللجنة</option>
              </select>
              <span class="esms-field__error" data-error></span>
            </div>
