<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<script>
(function(){
  try{
    var t = localStorage.getItem('esms-theme');
    document.documentElement.setAttribute('data-theme', t === 'light' ? 'light' : 'dark');
  }catch(e){ document.documentElement.setAttribute('data-theme','dark'); }
})();
</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ESMS — محاكاة سوق الأوراق المالية المصري</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=Amiri:wght@400;700&display=swap" rel="stylesheet">

<style>
/* ═══════════════════════════════════════════════════════════════════════
   PART 1 — DESIGN SYSTEM (منقول حرفيًا من esms-homepage-3.html)
   ═══════════════════════════════════════════════════════════════════════ */
:root{
  --bg:#FAF6EC; --bg-alt:#F3EDDE; --bg-raised:#ECE3CC;
  --text:#151B2C; --text-muted:#4A5468; --text-faint:#8891A5;
  --gold:#9C7A35; --gold-dim:#B79355;
  --line:rgba(21,27,44,0.09); --line-strong:rgba(21,27,44,0.16);
  --btn-bg:#151B2C; --btn-bg-hover:#9C7A35; --btn-text:#FAF6EC;
  --sel-bg:#B79355; --sel-text:#151B2C;
  --success:#5E8B5F; --success-bg:rgba(94,139,95,0.12);
  --warning:#B98A3B; --warning-bg:rgba(185,138,59,0.12);
  --danger:#A24848;  --danger-bg:rgba(162,72,72,0.12);
  --info:#4E6E9B;    --info-bg:rgba(78,110,155,0.12);
  --radius-sm:2px; --radius-md:3px; --radius-lg:6px; --radius-pill:999px;
  --shadow-sm:0 1px 2px rgba(0,0,0,.05);
  --shadow-md:0 8px 24px -12px rgba(0,0,0,.25);
  --shadow-lg:0 24px 60px -20px rgba(0,0,0,.35);
  --ease:cubic-bezier(.22,1,.36,1);
  --dur-fast:.2s; --dur:.35s; --dur-slow:.6s;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0A0F1C; --bg-alt:#0D1322; --bg-raised:#111827;
    --text:#F2EDE1; --text-muted:#8B93A6; --text-faint:#5C6478;
    --gold:#C9A961; --gold-dim:#8A754A;
    --line:rgba(242,237,225,0.09); --line-strong:rgba(242,237,225,0.16);
    --btn-bg:#F2EDE1; --btn-bg-hover:#C9A961; --btn-text:#050810;
    --sel-bg:#8A754A; --sel-text:#0A0F1C;
    --success:#7FB280; --danger:#C86B6B; --warning:#D4A95A; --info:#6A8EC2;
    --success-bg:rgba(127,178,128,0.14); --warning-bg:rgba(212,169,90,0.14);
    --danger-bg:rgba(200,107,107,0.14); --info-bg:rgba(106,142,194,0.14);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0A0F1C; --bg-alt:#0D1322; --bg-raised:#111827;
  --text:#F2EDE1; --text-muted:#8B93A6; --text-faint:#5C6478;
  --gold:#C9A961; --gold-dim:#8A754A;
  --line:rgba(242,237,225,0.09); --line-strong:rgba(242,237,225,0.16);
  --btn-bg:#F2EDE1; --btn-bg-hover:#C9A961; --btn-text:#050810;
  --sel-bg:#8A754A; --sel-text:#0A0F1C;
  --success:#7FB280; --danger:#C86B6B; --warning:#D4A95A; --info:#6A8EC2;
  --success-bg:rgba(127,178,128,0.14); --warning-bg:rgba(212,169,90,0.14);
  --danger-bg:rgba(200,107,107,0.14); --info-bg:rgba(106,142,194,0.14);
  color-scheme:dark;
}
:root[data-theme="light"]{ color-scheme:light; }

*,*::before,*::after{ box-sizing:border-box; margin:0; padding:0; }
html{ scroll-behavior:smooth; }
body{
  background:var(--bg); color:var(--text);
  font-family:'IBM Plex Sans Arabic',-apple-system,'Segoe UI',sans-serif;
  overflow-x:hidden; line-height:1.7;
  transition:background .4s ease, color .4s ease;
}
::selection{ background:var(--sel-bg); color:var(--sel-text); }
img{ max-width:100%; display:block; }
a{ color:inherit; text-decoration:none; }
button{ font-family:inherit; cursor:pointer; }
@media (prefers-reduced-motion:reduce){
  *{ animation-duration:.01ms !important; animation-iteration-count:1 !important;
     transition-duration:.01ms !important; scroll-behavior:auto !important; }
}
.container{ max-width:1180px; margin:0 auto; padding:0 clamp(20px,5vw,64px); }

/* Brand mark */
.mark-h{ display:inline-flex; align-items:flex-end; gap:3px; }
.mark-h i{ display:block; width:3px; background:var(--gold-dim); border-radius:1px; }
.mark-h i:nth-child(1){ height:6px; }
.mark-h i:nth-child(2){ height:12px; }
.mark-h i:nth-child(3){ height:17px; }
.mark-h i:nth-child(4){ height:9px; }
.mark-h.lg i{ width:4px; }
.mark-h.lg i:nth-child(1){ height:9px; }
.mark-h.lg i:nth-child(2){ height:18px; }
.mark-h.lg i:nth-child(3){ height:26px; }
.mark-h.lg i:nth-child(4){ height:14px; }

/* SPA pages */
.page{ display:none; }
.page.is-active{ display:block; animation:pageIn .5s var(--ease); }
@keyframes pageIn{ from{ opacity:0; transform:translateY(10px);} to{ opacity:1; transform:translateY(0);} }

/* Page transition overlay */
.page-transition{
  position:fixed; inset:0; z-index:9000; background:var(--bg);
  opacity:0; pointer-events:none; transition:opacity .28s var(--ease);
}
.page-transition.in{ opacity:1; pointer-events:auto; }

/* Toasts */
.toasts{ position:fixed; bottom:24px; left:24px; z-index:9500; display:flex; flex-direction:column; gap:12px; }
.toast{
  background:var(--bg-raised); border:1px solid var(--line-strong);
  border-radius:var(--radius-md); padding:14px 20px;
  font-size:14px; color:var(--text); min-width:260px;
  box-shadow:var(--shadow-md); transform:translateY(20px); opacity:0;
  transition:transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
}
.toast.in{ transform:translateY(0); opacity:1; }
.toast--success{ border-color:var(--success); }
.toast--danger{ border-color:var(--danger); }

/* ═══════════════════════════════════════════════════════════════════════
   PART 2 — HOMEPAGE STYLES (نفس esms-homepage-3.html)
   ═══════════════════════════════════════════════════════════════════════ */
/* (هنا كل الـ styles الأصلية من الموقع — سيتم نسخها إليها) */
/* ... سأتركها لك لتلصقها من ملفك الأصلي ... */
/* الأدنى: styles للـ announcement + nav + hero + sections */
.announce{ position:relative; background:var(--bg-alt); border-bottom:1px solid var(--line); }
.announce-inner{ display:flex; align-items:center; justify-content:center; gap:16px; flex-wrap:wrap;
  padding:11px clamp(20px,5vw,64px); font-size:13px; color:var(--text-muted); text-align:center; }
.announce-inner b{ color:var(--gold); font-weight:600; }
.announce-cta{ color:var(--text); border-bottom:1px solid var(--gold-dim); padding-bottom:1px; white-space:nowrap; }
.announce-close{ position:absolute; left:14px; top:50%; transform:translateY(-50%); background:none; border:none;
  color:var(--text-faint); font-size:18px; line-height:1; cursor:pointer; padding:6px; }
.announce-close:hover{ color:var(--text); }
.announce.hidden{ display:none; }

.nav{ position:sticky; top:0; z-index:100; display:flex; align-items:center; justify-content:space-between;
  padding:20px clamp(20px,5vw,64px);
  background:linear-gradient(to bottom, var(--bg) 60%, transparent);
  transition:background .4s ease, padding .3s ease, backdrop-filter .3s ease; }
.nav.scrolled{ background:color-mix(in srgb, var(--bg) 88%, transparent);
  backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  border-bottom:1px solid var(--line); padding-top:13px; padding-bottom:13px; }
.nav-mark{ display:flex; align-items:center; gap:11px; font-weight:600; font-size:15.5px; letter-spacing:.5px; }
.nav-links{ display:flex; align-items:center; gap:34px; font-size:14px; color:var(--text-muted); }
.nav-links a{ position:relative; padding-bottom:3px; transition:color .25s ease; white-space:nowrap; }
.nav-links a::after{ content:''; position:absolute; right:0; bottom:0; width:100%; height:1px;
  background:var(--gold); transform:scaleX(0); transform-origin:right;
  transition:transform .4s var(--ease); }
.nav-links a:hover{ color:var(--text); }
.nav-links a:hover::after{ transform:scaleX(1); }
.nav-right{ display:flex; align-items:center; gap:14px; }
.nav-cta{ border:1px solid var(--line-strong); padding:9px 22px; border-radius:2px; font-size:13px;
  color:var(--text); transition:border-color .3s ease, background .3s ease; white-space:nowrap; }
.nav-cta:hover{ border-color:var(--gold-dim); background:color-mix(in srgb, var(--gold) 8%, transparent); }
.theme-toggle{ width:38px; height:38px; border:1px solid var(--line-strong); border-radius:50%;
  background:transparent; color:var(--text); display:flex; align-items:center; justify-content:center;
  cursor:pointer; transition:border-color .3s ease, color .3s ease; flex-shrink:0; }
.theme-toggle:hover{ border-color:var(--gold-dim); color:var(--gold); }
.theme-toggle svg{ width:16px; height:16px; }
.theme-toggle .icon-moon{ display:none; }
:root[data-theme="light"] .theme-toggle .icon-sun{ display:none; }
:root[data-theme="light"] .theme-toggle .icon-moon{ display:block; }
.hamburger{ display:none; width:38px; height:38px; border:1px solid var(--line-strong); border-radius:2px;
  background:transparent; color:var(--text); align-items:center; justify-content:center; cursor:pointer; flex-shrink:0; }
.hamburger svg{ width:17px; height:17px; }
@media (max-width:860px){ .nav-links{ display:none; } .hamburger{ display:flex; } }
.mobile-menu{ position:fixed; inset:0; z-index:300; background:var(--bg);
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:30px;
  transform:translateY(-8px); opacity:0; pointer-events:none;
  transition:opacity .35s ease, transform .35s ease; }
.mobile-menu.open{ opacity:1; transform:translateY(0); pointer-events:auto; }
.mobile-menu a{ font-size:21px; color:var(--text); }
.mobile-menu .mm-cta{ margin-top:6px; border:1px solid var(--line-strong); padding:12px 30px;
  border-radius:2px; font-size:15px; }
.mobile-menu-close{ position:absolute; top:24px; left:24px; width:40px; height:40px;
  border:1px solid var(--line-strong); border-radius:50%; background:none; color:var(--text);
  display:flex; align-items:center; justify-content:center; cursor:pointer; }
.mobile-menu-close svg{ width:16px; height:16px; }

/* hero + scene */
.scene{ position:relative; background:var(--bg); }
.scene-bg{ position:absolute; inset:0; z-index:0; pointer-events:none; }
.scene-bg svg{ width:100%; height:100%; }
.book-bar{ fill:var(--text-faint); transform-box:fill-box; transform-origin:right center;
  transform:scaleX(0); animation:barGrow 1.3s var(--ease) forwards; opacity:.55; }
.book-bar.gold{ fill:var(--gold-dim); opacity:.8; }
@keyframes barGrow{ to{ transform:scaleX(1); } }
.price-line{ stroke:var(--gold); stroke-width:1; opacity:.5; animation:scan 16s ease-in-out infinite; }
@keyframes scan{ 0%,100%{ transform:translateX(0); } 50%{ transform:translateX(-360px); } }
.scene-vignette{ position:absolute; inset:0; z-index:1;
  background:radial-gradient(ellipse 90% 65% at 52% 26%, transparent 0%, var(--bg) 76%),
             linear-gradient(to bottom, transparent 60%, var(--bg) 100%); }
.hero-emblem{ position:absolute; z-index:0; left:clamp(-140px,-8vw,-40px); bottom:-40px;
  width:min(560px,58vw); opacity:.07; pointer-events:none; user-select:none; }

.hero{ position:relative; min-height:92svh; display:flex; flex-direction:column; justify-content:center; padding-top:40px; }
.hero-content{ position:relative; z-index:2; width:100%; }
.hero-eyebrow{ font-size:13px; color:var(--text-muted); margin-bottom:22px;
  opacity:0; transform:translateY(10px); animation:reveal .9s ease .9s forwards; }
.hero-eyebrow b{ color:var(--gold); font-weight:500; }
.hero-title{ font-size:clamp(38px,6.4vw,84px); font-weight:600; line-height:1.18; max-width:16ch; }
.hero-title span{ display:block; overflow:hidden; }
.hero-title span b{ display:block; opacity:0; transform:translateY(60%);
  animation:maskUp 1s var(--ease) forwards; font-weight:600; }
.hero-title span:nth-child(1) b{ animation-delay:1.05s; }
.hero-title span:nth-child(2) b{ animation-delay:1.2s; color:var(--gold); font-weight:500; }
@keyframes maskUp{ to{ opacity:1; transform:translateY(0); } }
.hero-sub{ margin-top:30px; max-width:46ch; font-size:clamp(15px,1.6vw,18px); color:var(--text-muted);
  opacity:0; animation:reveal .9s ease 1.7s forwards; }
@keyframes reveal{ to{ opacity:1; transform:translateY(0); } }
.hero-actions{ margin-top:46px; display:flex; gap:18px; align-items:center; flex-wrap:wrap;
  opacity:0; animation:reveal .9s ease 1.95s forwards; }
.btn-primary{ background:var(--btn-bg); color:var(--btn-text); padding:14px 30px; border-radius:2px;
  font-size:14.5px; font-weight:500;
  transition:transform .35s var(--ease), background .35s ease; display:inline-block; border:none; cursor:pointer; }
.btn-primary:hover{ transform:translateY(-2px); background:var(--btn-bg-hover); color:var(--btn-text); }
.btn-ghost{ color:var(--text); font-size:14.5px; padding:14px 2px; display:inline-flex;
  align-items:center; gap:8px; position:relative; }
.btn-ghost::after{ content:''; position:absolute; right:0; bottom:8px; width:100%; height:1px;
  background:var(--line-strong); transform:scaleX(1); transform-origin:right; }
.btn-ghost:hover::after{ background:var(--gold-dim); }
.hero-scroll{ position:absolute; bottom:30px; right:clamp(20px,5vw,64px); z-index:2;
  display:flex; flex-direction:column; align-items:center; gap:10px;
  opacity:0; animation:reveal 1s ease 2.3s forwards; }
.hero-scroll .track{ width:1px; height:46px; background:var(--line-strong); position:relative; overflow:hidden; }
.hero-scroll .track i{ position:absolute; top:-40%; right:0; left:0; height:40%; background:var(--gold);
  animation:trickle 2.2s ease-in-out infinite; }
@keyframes trickle{ 0%{ top:-40%; } 60%{ top:100%; } 100%{ top:100%; } }
.hero-scroll span{ font-size:11px; color:var(--text-faint); writing-mode:vertical-rl; letter-spacing:1px; }

.define{ position:relative; z-index:2; padding:0 0 clamp(90px,12vw,150px); }
.define-inner{ max-width:58ch; }
.kicker{ color:var(--gold); font-size:14px; margin-bottom:18px; }
h2.section-title{ font-size:clamp(28px,4vw,46px); font-weight:600; line-height:1.3; max-width:18ch; }
.section-lead{ color:var(--text-muted); font-size:16.5px; max-width:52ch; margin-top:18px; }
.sample-note{ font-size:12.5px; color:var(--text-faint); margin-top:16px; }
.sample-note b{ color:var(--gold-dim); font-weight:500; }
.field-ph{ border-bottom:1px dashed var(--text-faint); color:var(--text-muted); padding-bottom:1px; }

section{ position:relative; padding:clamp(90px,12vw,150px) 0; }
.divider{ position:relative; border-top:1px solid var(--line); }
.divider .mark-h{ position:absolute; top:0; right:50%; transform:translate(50%,-50%);
  background:var(--bg); padding:0 16px; z-index:2; }
.reveal{ opacity:0; transform:translateY(28px);
  transition:opacity .9s var(--ease), transform .9s var(--ease); }
.reveal.in{ opacity:1; transform:translateY(0); }
.reveal-delay-1.in{ transition-delay:.1s; }
.reveal-delay-2.in{ transition-delay:.2s; }
.reveal-delay-3.in{ transition-delay:.3s; }

/* flow */
.flow{ display:flex; gap:0; margin-top:70px; position:relative; }
.flow::before{ content:''; position:absolute; top:19px; right:0; left:0; height:1px; background:var(--line-strong); }
.flow-step{ flex:1; min-width:0; position:relative; padding-top:44px; }
.flow-step .node{ position:absolute; top:0; right:0; width:9px; height:9px; border-radius:50%;
  background:var(--bg); border:1px solid var(--gold-dim); transition:background .4s ease, border-color .4s ease; }
.flow-step.in .node{ background:var(--gold); border-color:var(--gold); }
.flow-step h3{ font-size:16px; font-weight:500; margin-bottom:8px; }
.flow-step p{ color:var(--text-muted); font-size:14px; max-width:22ch; }
@media (max-width:900px){ .flow{ overflow-x:auto; padding-bottom:10px; } .flow-step{ min-width:150px; } }

/* departments */
.dept-list{ margin-top:56px; }
.dept-row{ display:grid; grid-template-columns:56px 1fr; gap:26px; align-items:flex-start;
  padding:28px 0; border-top:1px solid var(--line); transition:background .4s ease; }
.dept-row:last-child{ border-bottom:1px solid var(--line); }
.dept-row:hover{ background:color-mix(in srgb, var(--gold) 4%, transparent); }
.dept-icon{ width:50px; height:50px; border-radius:50%; border:1px solid var(--line-strong); flex-shrink:0;
  display:flex; align-items:center; justify-content:center; color:var(--text-faint);
  transition:color .4s ease, border-color .4s ease; margin-top:2px; }
.dept-icon svg{ width:21px; height:21px; }
.dept-row:hover .dept-icon{ color:var(--gold); border-color:var(--gold-dim); }
.dept-row h3{ font-size:18px; font-weight:500; margin-bottom:8px; }
.dept-row p{ font-size:14px; color:var(--text-muted); line-height:1.7; max-width:60ch; }
@media (max-width:600px){ .dept-row{ grid-template-columns:42px 1fr; gap:16px; }
  .dept-icon{ width:38px; height:38px; } .dept-icon svg{ width:17px; height:17px; } }

/* people */
.people-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:1px;
  background:var(--line); margin-top:56px; }
.person{ background:var(--bg); padding:34px 22px 28px; text-align:center; }
.avatar{ width:58px; height:58px; border-radius:50%; margin:0 auto 18px;
  display:flex; align-items:center; justify-content:center;
  background:var(--bg-raised); border:1px solid var(--line-strong); color:var(--text-faint); }
.person h4{ font-size:14px; font-weight:500; }
.person p{ font-size:12.5px; color:var(--text-faint); margin-top:4px; }
@media (max-width:760px){ .people-grid{ grid-template-columns:repeat(2,1fr); } }

.leaders-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:26px; margin-top:56px; }
.leader-card{ background:var(--bg-alt); border:1px solid var(--line); border-radius:3px;
  overflow:hidden; transition:transform .45s var(--ease), border-color .35s ease, box-shadow .45s ease; }
.leader-card:hover{ transform:translateY(-5px); border-color:var(--gold-dim);
  box-shadow:0 18px 40px -20px rgba(0,0,0,.35); }
.leader-photo{ position:relative; aspect-ratio:3/4; overflow:hidden; background:var(--bg-raised); }
.leader-photo img{ width:100%; height:100%; object-fit:cover; object-position:top center; display:block;
  filter:grayscale(.25) contrast(1.02); transition:filter .5s ease, transform .6s var(--ease); }
.leader-card:hover .leader-photo img{ filter:grayscale(0); transform:scale(1.035); }
.leader-photo::after{ content:''; position:absolute; inset:0;
  background:linear-gradient(to top, color-mix(in srgb, var(--bg-alt) 55%, transparent) 0%, transparent 38%);
  pointer-events:none; }
.leader-info{ padding:20px 18px 26px; text-align:center; }
.leader-info h4{ font-size:14.5px; font-weight:600; line-height:1.4; }
.leader-info .role{ font-size:12px; color:var(--gold-dim); margin-top:5px; }
.leader-info p.bio{ font-size:12px; color:var(--text-faint); margin-top:11px; line-height:1.7; }
@media (max-width:900px){ .leaders-grid{ grid-template-columns:repeat(2,1fr); } }
@media (max-width:520px){ .leaders-grid{ grid-template-columns:1fr; } .leader-photo{ aspect-ratio:4/3; } }

.avatar-photo{ width:66px; height:66px; border-radius:50%; margin:0 auto 16px;
  position:relative; border:1px solid var(--line-strong); background:var(--bg-raised); overflow:visible; }
.avatar-photo .photo-mask{ width:100%; height:100%; border-radius:50%; overflow:hidden; display:block; }
.avatar-photo img{ width:100%; height:100%; object-fit:cover; display:block;
  filter:grayscale(.2); transition:filter .4s ease; }
.person:hover .avatar-photo img{ filter:grayscale(0); }
.role-icon{ position:absolute; bottom:-2px; left:-2px; width:22px; height:22px;
  border-radius:50%; background:var(--btn-bg); color:var(--btn-text);
  display:flex; align-items:center; justify-content:center; border:2px solid var(--bg); }
.role-icon svg{ width:11px; height:11px; }

/* posts, events, report */
.posts{ display:grid; grid-template-columns:1.3fr 1fr; gap:56px; margin-top:56px; }
.post-feature{ border-top:1px solid var(--line-strong); padding-top:26px; }
.post-feature h3{ font-size:clamp(22px,2.6vw,30px); font-weight:600; margin:6px 0 14px; max-width:20ch; }
.post-feature p{ color:var(--text-muted); font-size:14.5px; max-width:48ch; }
.post-feature .meta{ margin-top:22px; font-size:12.5px; color:var(--text-faint); }
.post-list{ display:flex; flex-direction:column; }
.post-row{ border-top:1px solid var(--line); padding:20px 0; display:flex; justify-content:space-between; gap:16px; }
.post-row:last-child{ border-bottom:1px solid var(--line); }
.post-row h4{ font-size:14.5px; font-weight:500; max-width:28ch; }
.post-row time{ font-size:12px; color:var(--text-faint); white-space:nowrap; }
@media (max-width:860px){ .posts{ grid-template-columns:1fr; } }

.events{ margin-top:56px; display:flex; flex-direction:column; }
.event-row{ display:grid; grid-template-columns:110px 1fr auto; gap:28px; align-items:center;
  padding:26px 0; border-top:1px solid var(--line); }
.event-row:last-child{ border-bottom:1px solid var(--line); }
.event-date{ display:flex; align-items:baseline; gap:8px; }
.event-date .day{ font-size:30px; font-weight:600; color:var(--gold); }
.event-date .rest{ font-size:12.5px; color:var(--text-muted); }
.event-title h4{ font-size:16px; font-weight:500; margin-bottom:6px; }
.event-title p{ font-size:13px; color:var(--text-faint); }
.event-arrow{ color:var(--text-faint); font-size:18px; transition:transform .3s ease, color .3s ease; }
.event-row:hover .event-arrow{ transform:translateX(-4px); color:var(--gold); }
@media (max-width:640px){ .event-row{ grid-template-columns:60px 1fr; } .event-arrow{ display:none; } }

.report{ display:grid; grid-template-columns:0.85fr 1.15fr; gap:64px; align-items:center; margin-top:56px; }
.report-cover{ aspect-ratio:3/4; border:1px solid var(--line-strong); position:relative;
  background:linear-gradient(160deg, var(--bg-raised) 0%, var(--bg) 70%);
  display:flex; flex-direction:column; justify-content:space-between; padding:32px; }
.report-cover .top{ font-size:12px; color:var(--text-faint); letter-spacing:0.5px; }
.report-cover .mid{ font-size:21px; font-weight:600; line-height:1.5; }
.report-cover .bottom{ font-size:12px; color:var(--gold); }
.report-stats{ display:grid; grid-template-columns:1fr 1fr; gap:34px 40px; }
.stat b{ display:block; font-size:clamp(26px,3vw,38px); font-weight:600; color:var(--text-faint); }
.stat span{ font-size:13px; color:var(--text-muted); margin-top:6px; display:block; }
.report-cta{ margin-top:38px; }
@media (max-width:860px){ .report{ grid-template-columns:1fr; } .report-cover{ max-width:280px; } }

/* contact */
.contact-grid{ display:grid; grid-template-columns:0.9fr 1.1fr; gap:64px; margin-top:56px; align-items:start; }
.contact-list{ display:flex; flex-direction:column; }
.contact-row{ display:flex; align-items:center; gap:20px; padding:22px 0; border-top:1px solid var(--line); }
.contact-list .contact-row:last-child{ border-bottom:1px solid var(--line); }
.contact-icon{ width:44px; height:44px; border-radius:50%; border:1px solid var(--line-strong);
  flex-shrink:0; display:flex; align-items:center; justify-content:center; color:var(--text-faint); }
.contact-icon svg{ width:18px; height:18px; }
.contact-row h4{ font-size:12.5px; color:var(--text-faint); font-weight:500; margin-bottom:4px; }
.contact-row a, .contact-row span.val{ font-size:15px; color:var(--text); }
.contact-row a:hover{ color:var(--gold); }
.contact-social{ display:flex; gap:14px; margin-top:30px; }
.contact-social a{ width:40px; height:40px; border:1px solid var(--line-strong); border-radius:50%;
  display:flex; align-items:center; justify-content:center; color:var(--text-muted);
  transition:color .3s ease, border-color .3s ease; }
.contact-social a:hover{ color:var(--gold); border-color:var(--gold-dim); }
.contact-social svg{ width:16px; height:16px; }
@media (max-width:860px){ .contact-grid{ grid-template-columns:1fr; gap:20px; } }

.final{ position:relative; text-align:center;
  padding-top:clamp(110px,14vw,190px); padding-bottom:clamp(110px,14vw,190px); overflow:hidden; }
.final-bg{ position:absolute; inset:0; z-index:0; opacity:.5; }
.final-bg svg{ width:100%; height:100%; }
.final-content{ position:relative; z-index:1; }
.final .status{ display:inline-flex; align-items:center; gap:8px; font-size:12.5px; color:var(--text-muted);
  border:1px solid var(--line-strong); border-radius:20px; padding:7px 16px; margin-bottom:28px; }
.final .status i{ width:7px; height:7px; border-radius:50%; background:#6EA96F;
  box-shadow:0 0 0 3px color-mix(in srgb, #6EA96F 20%, transparent); }
.final h2{ font-size:clamp(30px,5vw,56px); font-weight:600; max-width:18ch; margin:0 auto; line-height:1.3; }
.final p{ color:var(--text-muted); margin:24px auto 0; max-width:44ch; font-size:16px; }
.final .btn-primary{ margin-top:42px; padding:16px 42px; }

footer{ border-top:1px solid var(--line); padding:56px 0 40px; }
.foot-grid{ display:flex; justify-content:space-between; flex-wrap:wrap; gap:40px; }
.foot-brand{ display:flex; align-items:center; gap:10px; margin-bottom:14px; }
.foot-brand span{ font-weight:600; font-size:15px; }
.foot-mark{ font-size:14px; color:var(--text-muted); max-width:32ch; }
.foot-cols{ display:flex; gap:64px; flex-wrap:wrap; }
.foot-col h5{ font-size:12.5px; color:var(--text-faint); margin-bottom:16px; font-weight:500; }
.foot-col a{ position:relative; display:inline-block; font-size:13.5px; color:var(--text-muted); margin-bottom:10px; }
.foot-col a::after{ content:''; position:absolute; right:0; bottom:-2px; width:100%; height:1px;
  background:var(--gold-dim); transform:scaleX(0); transform-origin:right; transition:transform .35s ease; }
.foot-col a:hover{ color:var(--text); }
.foot-col a:hover::after{ transform:scaleX(1); }
.foot-bottom{ margin-top:56px; padding-top:24px; border-top:1px solid var(--line);
  font-size:12px; color:var(--text-faint); display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px; }

/* ═══════════════════════════════════════════════════════════════════════
   PART 3 — APPLY PAGE STYLES
   ═══════════════════════════════════════════════════════════════════════ */
.apply-nav{ display:flex; align-items:center; justify-content:space-between;
  padding:20px clamp(20px,5vw,64px); border-bottom:1px solid var(--line); }
.apply-nav a.back{ color:var(--text-muted); font-size:14px; display:inline-flex; align-items:center; gap:8px; cursor:pointer; }
.apply-nav a.back:hover{ color:var(--gold); }
.apply-nav .brand{ font-weight:600; font-size:15.5px; letter-spacing:.5px; }

.apply-hero{ padding:80px 0 40px; text-align:center; }
.apply-hero .kicker{ display:inline-block; }
.apply-hero h1.esms-h1{ font-size:clamp(34px,5.5vw,64px); font-weight:600; line-height:1.15;
  max-width:18ch; margin:8px auto 0; }
.apply-hero .section-lead{ margin:22px auto 0; }

.progress-rail{ display:flex; align-items:center; justify-content:center; gap:0;
  margin:48px auto 56px; max-width:820px; position:relative; }
.progress-rail::before{ content:''; position:absolute; top:19px; right:6%; left:6%;
  height:1px; background:var(--line-strong); }
.p-step{ flex:1; text-align:center; position:relative; z-index:1; }
.p-step__dot{ width:38px; height:38px; border-radius:50%; background:var(--bg);
  border:1px solid var(--line-strong); display:flex; align-items:center; justify-content:center;
  margin:0 auto 12px; font-size:13px; color:var(--text-faint); transition:all var(--dur) var(--ease); }
.p-step.is-active .p-step__dot{ border-color:var(--gold); color:var(--gold);
  box-shadow:0 0 0 4px color-mix(in srgb,var(--gold) 14%,transparent); }
.p-step.is-done .p-step__dot{ border-color:var(--gold); color:var(--bg); background:var(--gold); }
.p-step__label{ font-size:12px; color:var(--text-faint); }
.p-step.is-active .p-step__label, .p-step.is-done .p-step__label{ color:var(--text-muted); }
@media (max-width:640px){
  .p-step__label{ display:none; }
  .progress-rail::before{ right:12%; left:12%; }
}

.form-shell{ max-width:760px; margin:0 auto 96px; background:var(--bg-alt);
  border:1px solid var(--line); border-radius:var(--radius-lg);
  padding:clamp(28px,5vw,48px); box-shadow:var(--shadow-sm); }
.form-step{ display:none; animation:stepIn .5s var(--ease); }
.form-step.is-active{ display:block; }
@keyframes stepIn{ from{ opacity:0; transform:translateY(12px); } to{ opacity:1; transform:translateY(0); } }
.form-step__head{ margin-bottom:28px; }
.form-step__num{ font-size:12.5px; color:var(--gold); letter-spacing:.08em; }
.form-step__title{ font-size:clamp(22px,3vw,30px); font-weight:600; margin-top:6px; }
.form-step__desc{ color:var(--text-muted); font-size:14.5px; margin-top:8px; }

.form-grid{ display:grid; grid-template-columns:1fr 1fr; gap:0 20px; }
.form-grid .full{ grid-column:1 / -1; }
@media (max-width:640px){ .form-grid{ grid-template-columns:1fr; } }

.form-nav{ display:flex; justify-content:space-between; gap:12px;
  margin-top:36px; padding-top:28px; border-top:1px solid var(--line); }
.form-nav .spacer{ flex:1; }

/* Universal form controls (used in Apply + Admin) */
.esms-field{ display:flex; flex-direction:column; gap:8px; margin-bottom:22px; }
.esms-field__label{ font-size:13.5px; color:var(--text-muted); font-weight:500;
  display:flex; align-items:center; gap:6px; }
.esms-field__label .req{ color:var(--gold); }
.esms-field__hint{ font-size:12px; color:var(--text-faint); margin-top:2px; }
.esms-field__error{ font-size:12.5px; color:var(--danger); margin-top:4px; min-height:18px; }
.esms-input,.esms-select,.esms-textarea{ width:100%; background:var(--bg-raised);
  border:1px solid var(--line-strong); border-radius:var(--radius-md); color:var(--text);
  font-family:inherit; font-size:15px; padding:14px 16px; outline:none;
  transition:border-color var(--dur) var(--ease), background var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
.esms-input::placeholder,.esms-textarea::placeholder{ color:var(--text-faint); }
.esms-input:hover,.esms-select:hover,.esms-textarea:hover{ border-color:color-mix(in srgb,var(--gold) 40%,var(--line-strong)); }
.esms-input:focus,.esms-select:focus,.esms-textarea:focus{ border-color:var(--gold);
  box-shadow:0 0 0 3px color-mix(in srgb,var(--gold) 18%,transparent); background:var(--bg); }
.esms-textarea{ min-height:150px; resize:vertical; line-height:1.7; }
.esms-select{ appearance:none; padding-left:44px;
  background-image:linear-gradient(45deg,transparent 50%,var(--text-muted) 50%),
                   linear-gradient(135deg,var(--text-muted) 50%,transparent 50%);
  background-position:calc(0% + 18px) calc(50% - 2px), calc(0% + 24px) calc(50% - 2px);
  background-size:6px 6px, 6px 6px; background-repeat:no-repeat; }
[dir="rtl"] .esms-select{ padding-left:16px; padding-right:44px;
  background-position:calc(100% - 22px) calc(50% - 2px), calc(100% - 16px) calc(50% - 2px); }
.esms-field.has-error .esms-input,.esms-field.has-error .esms-select,
.esms-field.has-error .esms-textarea{ border-color:var(--danger); }
.esms-field.is-valid .esms-input,.esms-field.is-valid .esms-select{ border-color:var(--success); }

.esms-btn{ display:inline-flex; align-items:center; justify-content:center; gap:8px;
  border:1px solid transparent; border-radius:var(--radius-sm);
  padding:13px 26px; font-size:14.5px; font-weight:500; line-height:1;
  transition:transform var(--dur) var(--ease), background var(--dur) var(--ease),
             border-color var(--dur) var(--ease), color var(--dur) var(--ease); white-space:nowrap; cursor:pointer; }
.esms-btn:disabled{ opacity:.5; cursor:not-allowed; }
.esms-btn--primary{ background:var(--btn-bg); color:var(--btn-text); }
.esms-btn--primary:hover:not(:disabled){ transform:translateY(-2px); background:var(--btn-bg-hover); }
.esms-btn--ghost{ background:transparent; color:var(--text); border-color:var(--line-strong); }
.esms-btn--ghost:hover:not(:disabled){ border-color:var(--gold-dim); background:color-mix(in srgb,var(--gold) 6%,transparent); }
.esms-btn--text{ background:transparent; color:var(--gold); padding:8px 4px; }
.esms-btn--danger{ background:var(--danger); color:#fff; }
.esms-btn--danger:hover{ background:#8E3C3C; }
.esms-btn--sm{ padding:8px 16px; font-size:13px; }
.esms-btn--lg{ padding:16px 36px; font-size:15.5px; }
.esms-btn.is-loading{ pointer-events:none; position:relative; color:transparent; }
.esms-btn.is-loading::after{ content:''; position:absolute; inset:0; margin:auto;
  width:16px; height:16px; border:2px solid color-mix(in srgb,var(--btn-text) 40%,transparent);
  border-top-color:var(--btn-text); border-radius:50%; animation:spin .8s linear infinite; }
@keyframes spin{ to{ transform:rotate(360deg); } }

.review-block{ border:1px solid var(--line); border-radius:var(--radius-md);
  padding:20px 22px; margin-bottom:14px; }
.review-block h4{ font-size:12.5px; color:var(--text-faint); margin-bottom:12px; font-weight:500; letter-spacing:.04em; }
.review-row{ display:flex; justify-content:space-between; gap:16px; padding:8px 0;
  border-bottom:1px dashed var(--line); font-size:14.5px; }
.review-row:last-child{ border-bottom:none; }
.review-row .k{ color:var(--text-muted); }
.review-row .v{ color:var(--text); max-width:60%; text-align:left; word-break:break-word; }

.success-state{ display:none; text-align:center; padding:60px 20px; animation:stepIn .6s var(--ease); }
.success-state.is-active{ display:block; }
.success-icon{ width:72px; height:72px; border-radius:50%; margin:0 auto 24px;
  border:1px solid var(--gold); color:var(--gold); display:flex; align-items:center; justify-content:center;
  background:color-mix(in srgb,var(--gold) 8%,transparent); }
.success-icon svg{ width:28px; height:28px; }

/* ═══════════════════════════════════════════════════════════════════════
   PART 4 — ADMIN STYLES
   ═══════════════════════════════════════════════════════════════════════ */
.admin-shell{ display:grid; grid-template-columns:260px 1fr; height:100vh; overflow:hidden;
  transition:grid-template-columns .3s var(--ease); }
.admin-shell.collapsed{ grid-template-columns:72px 1fr; }

.admin-sidebar{ background:var(--bg-alt); border-left:1px solid var(--line);
  display:flex; flex-direction:column; overflow-y:auto; transition:width .3s var(--ease); }
.admin-sidebar__head{ display:flex; align-items:center; gap:12px; padding:22px 20px;
  border-bottom:1px solid var(--line); height:74px; }
.admin-sidebar__head .mark-h i{ background:var(--gold); }
.admin-sidebar__head .brand-name{ font-weight:600; font-size:14.5px; letter-spacing:.4px; white-space:nowrap; }
.admin-sidebar__head .brand-sub{ font-size:11px; color:var(--text-faint); letter-spacing:.05em; }
.admin-sidebar.collapsed .brand-name, .admin-sidebar.collapsed .brand-sub{ display:none; }

.nav-group{ padding:14px 10px; }
.nav-group__title{ font-size:11px; color:var(--text-faint); letter-spacing:.08em;
  padding:10px 12px 6px; text-transform:uppercase; }
.admin-sidebar.collapsed .nav-group__title{ text-align:center; font-size:9px; }
.nav-item{ display:flex; align-items:center; gap:12px; padding:10px 14px;
  border-radius:var(--radius-md); color:var(--text-muted); font-size:13.5px; cursor:pointer;
  transition:background var(--dur-fast), color var(--dur-fast); position:relative; }
.nav-item svg{ width:17px; height:17px; flex-shrink:0; }
.nav-item:hover{ color:var(--text); background:color-mix(in srgb,var(--gold) 6%,transparent); }
.nav-item.is-active{ color:var(--text); background:color-mix(in srgb,var(--gold) 12%,transparent); }
.nav-item.is-active::before{ content:''; position:absolute; right:0; top:8px; bottom:8px; width:2px; background:var(--gold); }
.admin-sidebar.collapsed .nav-item span{ display:none; }
.admin-sidebar.collapsed .nav-item{ justify-content:center; }
.nav-item .count{ margin-inline-start:auto; font-size:11px; padding:2px 8px;
  background:var(--gold); color:var(--bg); border-radius:var(--radius-pill); font-weight:600; }
.admin-sidebar.collapsed .nav-item .count{ display:none; }

.admin-sidebar__foot{ margin-top:auto; padding:14px 16px; border-top:1px solid var(--line);
  display:flex; align-items:center; gap:12px; font-size:12.5px; color:var(--text-faint); }
.avatar-sm{ width:32px; height:32px; border-radius:50%; background:var(--bg-raised);
  border:1px solid var(--line-strong); display:flex; align-items:center; justify-content:center;
  font-size:12px; color:var(--gold); }

.admin-main{ display:flex; flex-direction:column; overflow:hidden; background:var(--bg); }
.admin-topbar{ height:74px; border-bottom:1px solid var(--line); display:flex; align-items:center;
  gap:16px; padding:0 24px; background:var(--bg); flex-shrink:0; }
.admin-topbar__toggle{ width:36px; height:36px; border:1px solid var(--line-strong);
  border-radius:var(--radius-md); background:transparent; color:var(--text-muted);
  display:flex; align-items:center; justify-content:center; }
.admin-topbar__toggle:hover{ color:var(--gold); border-color:var(--gold-dim); }
.admin-topbar__title{ font-size:15.5px; font-weight:500; }
.admin-topbar__crumbs{ font-size:12.5px; color:var(--text-faint); }
.admin-topbar__spacer{ flex:1; }
.admin-search{ background:var(--bg-raised); border:1px solid var(--line-strong);
  border-radius:var(--radius-md); color:var(--text); padding:9px 14px;
  font-size:13px; min-width:240px; font-family:inherit; }
.admin-search:focus{ outline:none; border-color:var(--gold); }
.admin-content{ flex:1; overflow-y:auto; padding:32px clamp(20px,3vw,40px); }
.admin-content h1{ font-size:24px; font-weight:600; margin-bottom:6px; }
.admin-content .sub{ font-size:13.5px; color:var(--text-muted); margin-bottom:28px; }

.stats-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:16px; margin-bottom:32px; }
.stat-card{ background:var(--bg-alt); border:1px solid var(--line);
  border-radius:var(--radius-lg); padding:22px; transition:border-color var(--dur) var(--ease); }
.stat-card:hover{ border-color:var(--gold-dim); }
.stat-card .label{ font-size:12.5px; color:var(--text-faint); margin-bottom:10px; }
.stat-card .value{ font-size:32px; font-weight:600; color:var(--text); line-height:1; }
.stat-card .delta{ font-size:12px; color:var(--success); margin-top:8px; }
.stat-card .delta.muted{ color:var(--text-faint); }

.sec-head{ display:flex; align-items:center; justify-content:space-between;
  margin-bottom:16px; gap:16px; flex-wrap:wrap; }
.sec-head h2{ font-size:16px; font-weight:600; }
.sec-head .actions{ display:flex; gap:10px; flex-wrap:wrap; }

.view{ display:none; }
.view.is-active{ display:block; animation:stepIn .4s var(--ease); }

.filters{ display:flex; gap:10px; flex-wrap:wrap; margin-bottom:16px; }
.filters .esms-input,.filters .esms-select{ padding:9px 14px; font-size:13px; max-width:220px; }

.esms-table-wrap{ border:1px solid var(--line); border-radius:var(--radius-lg);
  overflow:hidden; background:var(--bg-alt); }
.esms-table{ width:100%; border-collapse:collapse; font-size:14px; }
.esms-table th{ text-align:start; font-weight:500; font-size:12.5px; color:var(--text-faint);
  padding:14px 18px; border-bottom:1px solid var(--line); background:var(--bg-raised);
  letter-spacing:.02em; }
.esms-table td{ padding:16px 18px; border-bottom:1px solid var(--line); color:var(--text); }
.esms-table tbody tr:last-child td{ border-bottom:none; }
.esms-table tbody tr{ transition:background var(--dur) var(--ease); }
.esms-table tbody tr:hover{ background:color-mix(in srgb,var(--gold) 4%,transparent); }

.esms-badge{ display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:500;
  padding:4px 10px; border-radius:var(--radius-pill); border:1px solid var(--line-strong);
  color:var(--text-muted); background:var(--bg-raised); }
.esms-badge i{ width:6px; height:6px; border-radius:50%; background:currentColor; }
.esms-badge--success{ color:var(--success); background:var(--success-bg); border-color:transparent; }
.esms-badge--warning{ color:var(--warning); background:var(--warning-bg); border-color:transparent; }
.esms-badge--danger{ color:var(--danger); background:var(--danger-bg); border-color:transparent; }
.esms-badge--info{ color:var(--info); background:var(--info-bg); border-color:transparent; }
.esms-badge--gold{ color:var(--gold); background:color-mix(in srgb,var(--gold) 14%,transparent); border-color:transparent; }

.drawer-bg{ position:fixed; inset:0; background:rgba(0,0,0,.4); backdrop-filter:blur(4px);
  z-index:400; opacity:0; pointer-events:none; transition:opacity var(--dur) var(--ease); }
.drawer-bg.open{ opacity:1; pointer-events:auto; }
.drawer{ position:fixed; top:0; left:0; bottom:0; width:min(560px,92vw);
  background:var(--bg); border-right:1px solid var(--line-strong);
  transform:translateX(-100%); transition:transform var(--dur) var(--ease);
  display:flex; flex-direction:column; z-index:401; }
.drawer-bg.open .drawer{ transform:translateX(0); }
.drawer__head{ padding:22px 26px; border-bottom:1px solid var(--line);
  display:flex; align-items:center; justify-content:space-between; }
.drawer__body{ flex:1; overflow-y:auto; padding:24px 26px; }
.drawer__foot{ padding:18px 26px; border-top:1px solid var(--line);
  display:flex; gap:10px; flex-wrap:wrap; }
